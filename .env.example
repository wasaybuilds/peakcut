# Copy to .env (repo root) and fill in. Every key here has a free tier.
# Leave a key empty to skip that provider; the fallback chain moves on.

# --- Speech-to-text -----------------------------------------------------------
# Groq: free whisper-large-v3-turbo with word timestamps. https://console.groq.com/keys
GROQ_API_KEY=

# SiliconFlow: free SenseVoiceSmall ASR + free Qwen LLMs. https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# Local fallback (CPU). tiny | base | small | medium. "small" is the sweet spot on Iris Xe.
LOCAL_WHISPER_MODEL=small

# --- LLMs (highlight picking, titles, hashtags) --------------------------------
# Z.ai (Zhipu GLM, international): glm-4.5-flash / glm-4.7-flash are free. https://z.ai/manage-apikey/apikey-list
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-flash

SILICONFLOW_MODEL=Qwen/Qwen3-8B
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free models (50 req/day free). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Gemini: free tier, can "watch" YouTube URLs directly. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Order the fallback chain tries LLM providers in (comma separated).
LLM_ORDER=zhipu,siliconflow,groq,openrouter,gemini

# --- YouTube access ---------------------------------------------------------------
# Only if YouTube says "Sign in to confirm you're not a bot". Use ONE of these.
# Browser must be logged in to YouTube. Firefox works best (Chrome/Edge lock cookies while open).
YTDLP_COOKIES_FROM_BROWSER=
# Or export cookies.txt with the "Get cookies.txt LOCALLY" browser extension:
YTDLP_COOKIES_FILE=

# --- Rendering ------------------------------------------------------------------
# auto = try Intel QuickSync (h264_qsv) then fall back to libx264
VIDEO_ENCODER=auto
DEFAULT_CLIP_COUNT=8
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=60

# --- Publishing (M4) ------------------------------------------------------------
# YouTube: path to the OAuth "Desktop app" client JSON from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=backend/tokens/client_secret.json
# Instagram (Instagram Login API, professional account)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok (Login Kit for Desktop + Content Posting API, scopes user.info.basic and video.upload).
# Redirect URI to register in the TikTok app: http://localhost:8788/callback/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_PORT=8788

# --- App ------------------------------------------------------------------------
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
